---
import ImageWrapper from '../misc/ImageWrapper.astro'
import { Icon } from 'astro-icon/components'
import { profileConfig } from '../../config'

const config = profileConfig
---
<div class="card-base px-5 py-6">
    <a aria-label="Go to About Page" href="/"
       class="group block relative mx-auto mb-4 max-w-[112px] overflow-hidden rounded-full active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="font-medium text-lg text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
    <div class="text-center text-neutral-400 text-sm mb-4 transition">{config.bio}</div>
    <div class="flex gap-2 justify-center">
        {config.links.map(item =>
            <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-plain rounded-full h-9 w-9 active:scale-90">
                <Icon name={item.icon} size="1.2rem"></Icon>
            </a>
        )}
    </div>
</div>
