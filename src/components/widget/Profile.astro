---
import ImageWrapper from '../misc/ImageWrapper.astro'
import { Icon } from 'astro-icon/components'
import { profileConfig } from '../../config'

const config = profileConfig
---
<div class="profile-minimal">
    <a aria-label="Go to About Page" href="/"
       class="group block relative profile-avatar overflow-hidden rounded-full active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="profile-copy">
      <div class="font-medium text-base mb-1 dark:text-neutral-50 transition">{config.name}</div>
      <div class="text-neutral-400 text-xs leading-relaxed transition">{config.bio}</div>
    </div>
    <div class="profile-links">
        {config.links.map(item =>
            <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="profile-link active:scale-90">
                <Icon name={item.icon} size="1rem"></Icon>
            </a>
        )}
    </div>
</div>

<style lang="stylus">
  .profile-minimal
    display: grid
    grid-template-columns: 3.5rem 1fr
    gap: 0.9rem 1rem
    align-items: center
    padding: 1.1rem 0.5rem 0.8rem
  .profile-avatar
    width: 3.5rem
    height: 3.5rem
  .profile-copy
    min-width: 0
  .profile-links
    grid-column: 2
    display: flex
    gap: 0.85rem
  .profile-link
    color: rgba(145, 145, 145, 0.85)
    transition: color 0.2s ease
  .profile-link:hover
    color: var(--primary)
  @media (max-width: 1023px)
    .profile-minimal
      grid-template-columns: 3rem minmax(0, 1fr) auto
      gap: 0.7rem 0.9rem
      padding: 1rem 0.25rem 0.7rem
    .profile-avatar
      width: 3rem
      height: 3rem
    .profile-links
      grid-column: 3
      grid-row: 1
      align-self: center
      gap: 1rem
    .profile-link
      display: flex
      align-items: center
      justify-content: center
      width: 2.25rem
      height: 2.25rem
  @media (max-width: 420px)
    .profile-minimal
      grid-template-columns: 3rem minmax(0, 1fr)
    .profile-links
      grid-column: 2
      grid-row: 2
      justify-content: flex-start
</style>
