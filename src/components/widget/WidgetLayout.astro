---
import { Icon } from 'astro-icon/components'
import { i18n } from '../../i18n/translation'
import I18nKey from '../../i18n/i18nKey'
interface Props {
  id: string
  name?: string
  isCollapsed?: boolean
  collapsedHeight?: string
  class?: string
  style?: string
}
const props = Astro.props
const { id, name, isCollapsed, collapsedHeight, style } = Astro.props
const className = Astro.props.class
---
<widget-layout data-id={id} data-is-collapsed={isCollapsed} class={"sidebar-section " + className} style={style}>
    <div class="sidebar-heading">{name}</div>
    <div id={id} class:list={["collapse-wrapper overflow-hidden", {"collapsed": isCollapsed}]}>
        <slot></slot>
    </div>
    {isCollapsed && <div class="expand-btn">
        <button class="sidebar-more">
            <Icon name="material-symbols:more-horiz" size={20}></Icon>
            <span>{i18n(I18nKey.more)}</span>
        </button>
    </div>}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
    .sidebar-section {
        display: block;
        padding: 1rem 0.25rem 0;
    }
    .sidebar-heading {
        margin: 0 0 0.75rem 0.5rem;
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(140, 140, 140, 0.85);
    }
    .collapsed {
        height: var(--collapsedHeight);
    }
    .sidebar-more {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin: 0.4rem 0 0 0.35rem;
        padding: 0.3rem 0.4rem;
        color: rgba(140, 140, 140, 0.9);
        font-size: 0.72rem;
        transition: color 0.2s ease;
    }
    .sidebar-more:hover {
        color: var(--primary);
    }
    @media (max-width: 1023px) {
        .sidebar-section {
            padding-top: 0.9rem;
        }
        .sidebar-heading {
            margin-left: 0.3rem;
        }
    }
</style>

<script>
    class WidgetLayout extends HTMLElement {
        constructor() {
            super();

            if (this.dataset.isCollapsed === undefined || this.dataset.isCollapsed === false)
                return;

            const id = this.dataset.id;
            const btn = this.querySelector('.expand-btn');
            const wrapper = this.querySelector(`#${id}`)
            btn.addEventListener('click', () => {
                wrapper.classList.remove('collapsed');
                btn.classList.add('hidden');
            })
        }
    }

    customElements.define('widget-layout', WidgetLayout);
</script>
