---
import { getSortedPosts } from '../utils/content-utils'
import { getPostUrlBySlug } from '../utils/url-utils'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import { UNCATEGORIZED } from '@constants/constants'

interface Props {
  keyword: string
  tags: string[]
  categories: string[]
  external: boolean
  link: string
}
const { keyword, tags, categories, external, link } = Astro.props

let posts = await getSortedPosts()

if (Array.isArray(tags) && tags.length > 0) {
  posts = posts.filter(
    post =>
      Array.isArray(post.data.tags) &&
      post.data.tags.some(tag => tags.includes(tag)),
  )
}

if (Array.isArray(categories) && categories.length > 0) {
  posts = posts.filter(
    post =>
      (post.data.category && categories.includes(post.data.category)) ||
      (!post.data.category && categories.includes(UNCATEGORIZED)),
  )
}

const groups = (function () {
  const groupedPosts = posts.reduce((grouped, post) => {
    const year = post.data.published.getFullYear()
    if (!grouped[year]) {
      grouped[year] = []
    }
    grouped[year].push(post)
    return grouped
  }, {})

  // convert the object to an array
  const groupedPostsArray = Object.keys(groupedPosts).map(key => ({
    year: key,
    posts: groupedPosts[key],
  }))

  // sort years by latest first
  groupedPostsArray.sort((a, b) => b.year - a.year)
  return groupedPostsArray
})()

function formatDate(date: Date) {
  const month = (date.getMonth() + 1).toString().padStart(2, '0')
  const day = date.getDate().toString().padStart(2, '0')
  return `${month}-${day}`
}

function formatTag(tag: string[]) {
  return tag.map(t => `#${t}`).join(' ')
}

const generateUrl = post => {
  return post.data.external ? post.data.link : getPostUrlBySlug(post.slug)
}
---

<div class="card-base px-6 md:px-10 py-8">
    {
        groups.map(group => (
            <section class="arc-group reveal">
                <div class="arc-year-row">
                    <span class="arc-year">{group.year}</span>
                    <span class="arc-year-count">{group.posts.length} {i18n(I18nKey.postsCount)}</span>
                    <span class="arc-year-rule"></span>
                </div>
                <div class="arc-list">
                    {group.posts.map(post => (
                        <a href={generateUrl(post)} aria-label={post.data.title} class="arc-row group">
                            <time class="arc-date">{formatDate(post.data.published)}</time>
                            <span class="arc-node"><span class="arc-dot"></span></span>
                            <span class="arc-title">{post.data.title}</span>
                            <span class="arc-tags">{formatTag(post.data.tags)}</span>
                        </a>
                    ))}
                </div>
            </section>
        ))
    }
</div>

<style lang="stylus">
  .arc-group
    margin-bottom: 1.75rem
  .arc-group:last-child
    margin-bottom: 0

  .arc-year-row
    display: flex
    align-items: baseline
    gap: 0.8rem
    margin-bottom: 0.6rem
  .arc-year
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 1.9rem
    font-weight: 700
    letter-spacing: -0.02em
    color: var(--deep-text, #262626)
  :global(.dark) .arc-year
    color: #ededed
  .arc-year-count
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.75rem
    color: var(--primary)
  .arc-year-rule
    flex: 1
    height: 1px
    background: unquote('linear-gradient(to right, color-mix(in oklch, var(--primary) 40%, transparent), transparent)')

  .arc-list
    position: relative
    padding-left: 0.2rem

  .arc-row
    position: relative
    display: grid
    grid-template-columns: 3.4rem 1.6rem 1fr auto
    align-items: center
    gap: 0.6rem
    padding: 0.55rem 0.6rem
    border-radius: 0.5rem
    transition: background 0.25s ease
  .arc-row:hover
    background: unquote('color-mix(in oklch, var(--primary) 8%, transparent)')

  .arc-date
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.78rem
    color: rgba(140, 140, 140, 0.95)
    text-align: right

  .arc-node
    position: relative
    display: flex
    align-items: center
    justify-content: center
    height: 100%
  // vertical connecting line
  .arc-node::before
    content: ""
    position: absolute
    left: 50%
    top: -50%
    height: 100%
    border-left: 2px dashed var(--line-color, rgba(128,128,128,0.25))
    transform: translateX(-1px)
  .arc-dot
    position: relative
    z-index: 2
    width: 0.4rem
    height: 0.4rem
    border-radius: 999px
    background: oklch(0.6 0.04 var(--hue))
    outline: 4px solid var(--card-bg)
    transition: all 0.25s ease
  .arc-row:hover .arc-dot
    height: 1.2rem
    background: var(--primary)

  .arc-title
    font-weight: 600
    font-size: 0.95rem
    color: rgba(90, 90, 90, 0.98)
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    padding-right: 1rem
    transition: transform 0.25s ease, color 0.2s ease
  :global(.dark) .arc-title
    color: rgba(210, 210, 210, 0.95)
  .arc-row:hover .arc-title
    transform: translateX(4px)
    color: var(--primary)

  .arc-tags
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.74rem
    color: rgba(150, 150, 150, 0.7)
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    max-width: 12rem
  @media (max-width: 768px)
    .arc-tags
      display: none
    .arc-row
      grid-template-columns: 3rem 1.4rem 1fr
</style>