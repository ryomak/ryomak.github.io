---
import { getCollection } from 'astro:content'
import { getSortedPosts } from '../utils/content-utils'
import { getPostUrlBySlug } from '../utils/url-utils'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import { UNCATEGORIZED } from '@constants/constants'

interface Props {
  keyword: string
  tags: string[]
  categories: string[]
  external: boolean
  link: string
}
const { keyword, tags, categories, external, link } = Astro.props

let posts = await getSortedPosts()

if (Array.isArray(tags) && tags.length > 0) {
  posts = posts.filter(
    post =>
      Array.isArray(post.data.tags) &&
      post.data.tags.some(tag => tags.includes(tag)),
  )
}

if (Array.isArray(categories) && categories.length > 0) {
  posts = posts.filter(
    post =>
      (post.data.category && categories.includes(post.data.category)) ||
      (!post.data.category && categories.includes(UNCATEGORIZED)),
  )
}

type Entry = {
  date: Date
  title: string
  url: string
  tags: string[]
  /** shown in place of tags for anything that isn't a post */
  kind?: string
}

const entries: Entry[] = posts.map(post => ({
  date: post.data.published,
  title: post.data.title,
  url: post.data.external ? post.data.link : getPostUrlBySlug(post.slug),
  tags: post.data.tags ?? [],
}))

// Decks belong on the timeline too. They carry no tags or category, so they
// only show up on the unfiltered archive — a tag/category view would otherwise
// list entries that don't match the filter.
const isFiltered =
  (Array.isArray(tags) && tags.length > 0) ||
  (Array.isArray(categories) && categories.length > 0)

if (!isFiltered) {
  const decks = await getCollection('slides', ({ data }) =>
    import.meta.env.DEV ? true : !data.draft,
  )
  entries.push(
    ...decks.map(deck => ({
      date: deck.data.published,
      title: deck.data.title,
      url: `/slides/${deck.slug}/`,
      tags: [],
      kind: 'SLIDES',
    })),
  )
}

const groups = (function () {
  const grouped = entries.reduce((acc, entry) => {
    const year = entry.date.getFullYear()
    if (!acc[year]) acc[year] = []
    acc[year].push(entry)
    return acc
  }, {} as Record<number, Entry[]>)

  return Object.keys(grouped)
    .map(key => ({
      year: key,
      // newest first inside the year, since slides were merged in afterwards
      entries: grouped[key].sort((a, b) => b.date.valueOf() - a.date.valueOf()),
    }))
    .sort((a, b) => Number(b.year) - Number(a.year))
})()

function formatDate(date: Date) {
  const month = (date.getMonth() + 1).toString().padStart(2, '0')
  const day = date.getDate().toString().padStart(2, '0')
  return `${month}-${day}`
}

function formatTag(tag: string[]) {
  return tag.map(t => `#${t}`).join(' ')
}

---

<div class="card-base px-6 md:px-10 py-8">
    {
        groups.map(group => (
            <section class="arc-group reveal">
                <div class="arc-year-row">
                    <span class="arc-year">{group.year}</span>
                    <span class="arc-year-count">{group.entries.length} {i18n(I18nKey.postsCount)}</span>
                    <span class="arc-year-rule"></span>
                </div>
                <div class="arc-list">
                    {group.entries.map(entry => (
                        <a href={entry.url} aria-label={entry.title} data-no-swup={entry.kind ? '' : undefined} class:list={['arc-row group', { 'is-slides': entry.kind === 'SLIDES' }]}>
                            <time class="arc-date">{formatDate(entry.date)}</time>
                            <span class="arc-node"><span class="arc-dot"></span></span>
                            <span class="arc-title">{entry.title}</span>
                            {entry.kind
                              ? <span class="arc-kind">{entry.kind}</span>
                              : <span class="arc-tags">{formatTag(entry.tags)}</span>}
                        </a>
                    ))}
                </div>
            </section>
        ))
    }
</div>

<style lang="stylus">
  .arc-group
    margin-bottom: 1.75rem
  .arc-group:last-child
    margin-bottom: 0

  .arc-year-row
    display: flex
    align-items: baseline
    gap: 0.8rem
    margin-bottom: 0.6rem
  .arc-year
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 1.9rem
    font-weight: 500
    letter-spacing: -0.02em
    color: var(--deep-text, #262626)
  :global(.dark) .arc-year
    color: #ededed
  .arc-year-count
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.75rem
    color: var(--primary)
  .arc-year-rule
    flex: 1
    height: 1px
    background: var(--line-color)

  .arc-list
    position: relative
    padding-left: 0.2rem

  .arc-row
    position: relative
    display: grid
    grid-template-columns: 3.4rem 1fr auto
    align-items: center
    gap: 0.6rem
    padding: 0.55rem 0.6rem
    border-radius: 0
    border-bottom: 1px solid var(--line-color)
    transition: color 0.2s ease
  .arc-row:hover
    background: transparent

  .arc-date
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.78rem
    color: rgba(140, 140, 140, 0.95)
    text-align: right

  .arc-node
    display: none
  .arc-title
    font-weight: 600
    font-size: 0.95rem
    color: rgba(90, 90, 90, 0.98)
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    padding-right: 1rem
    transition: transform 0.25s ease, color 0.2s ease
  :global(.dark) .arc-title
    color: rgba(210, 210, 210, 0.95)
  .arc-row:hover .arc-title
    color: var(--primary)

  // decks get a label instead of tags, and a filled dot on the timeline
  .arc-kind
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.62rem
    letter-spacing: 0.1em
    color: var(--primary)
    border: 1px solid unquote('color-mix(in oklch, var(--primary) 35%, transparent)')
    border-radius: 999px
    padding: 0.08rem 0.5rem
    white-space: nowrap
  .arc-tags
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.74rem
    color: rgba(150, 150, 150, 0.7)
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    max-width: 12rem
  @media (max-width: 768px)
    .arc-tags
      display: none
    .arc-kind
      display: none
    .arc-row
      grid-template-columns: 3rem 1fr
</style>
