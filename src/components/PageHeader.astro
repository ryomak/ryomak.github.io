---
import '@fontsource-variable/jetbrains-mono'

interface Props {
  title: string
  subtitle?: string
  count?: number
  countLabel?: string
}
const { title, subtitle, count, countLabel } = Astro.props
---
<header class="page-header reveal card-base px-6 py-7 md:px-8 md:py-9 mb-4">
  <div class="ph-top">
    <h1 class="ph-title">{title}</h1>
    {count !== undefined && (
      <span class="ph-count">{count}{countLabel ? ` ${countLabel}` : ''}</span>
    )}
  </div>
  {subtitle && <p class="ph-sub">{subtitle}</p>}
</header>

<style lang="stylus">
  .ph-top
    display: flex
    align-items: baseline
    gap: 1rem
  .ph-title
    font-weight: 500
    font-size: clamp(2rem, 5vw, 3.25rem)
    letter-spacing: -0.045em
    line-height: 1
    white-space: nowrap
  .ph-count
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.78rem
    color: rgba(128, 128, 128, 0.9)
    white-space: nowrap
  .ph-sub
    margin-top: 0.9rem
    color: rgba(128, 128, 128, 0.95)
    font-size: 0.92rem
</style>
