---
import { nowLead } from '../data'
---
<div class="mg-now">
  <p class="mg-now-lead reveal" style="--d: 60ms">{nowLead}</p>
</div>

<style lang="stylus">
  .mg-now
    max-width: 42rem
  .mg-now-lead
    font-size: clamp(1.05rem, 2.2vw, 1.5rem)
    line-height: 1.7
    font-weight: 300
    letter-spacing: 0.01em
    color: var(--mg-ink)
</style>
