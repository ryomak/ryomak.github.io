---
import HeroWebGL from '../HeroWebGL.astro'
import { profileConfig } from '@/config'
import { sections } from '../data'
import '@fontsource-variable/jetbrains-mono'

const last = sections[sections.length - 1]
---
<section class="mg-sec mg-hero" id="sec-0" data-mg-index="0">
<HeroWebGL mono colorVar="--mg-ink" />

<div class="mg-hero-inner">
  <div class="mg-eyebrow reveal" style="--d: 0ms">
    <span class="mg-stitches" aria-hidden="true">
      <svg viewBox="0 0 44 14" width="44" height="14"><g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <line x1="4" y1="2" x2="4" y2="12"></line><line x1="16" y1="2" x2="16" y2="12"></line>
        <line x1="28" y1="2" x2="28" y2="12"></line><line x1="40" y1="2" x2="40" y2="12"></line>
      </g></svg>
    </span>
    <span>INDEX · 00—{last.num} — TOKYO</span>
  </div>

  <h1 class="mg-name reveal" style="--d: 80ms">kurisu</h1>

  <p class="mg-caption reveal" style="--d: 160ms">
    <span class="mg-circle-mark" aria-hidden="true"></span> BACKEND ENGINEER
  </p>
  <p class="mg-bio reveal" style="--d: 220ms">{profileConfig.bio}</p>

  <nav class="mg-social reveal" style="--d: 300ms">
    {profileConfig.links.map(item => (
      <a class="mg-link" href={item.url} target="_blank" rel="me noopener" data-magnetic>{item.name}</a>
    ))}
  </nav>
</div>

<div class="mg-scroll" aria-hidden="true"><span>SCROLL</span><i></i></div>
</section>

<style lang="stylus">
  .mg-sec
    position: relative
    z-index: 1
    padding: 2.5rem 0.5rem
  .mg-hero
    min-height: min(78vh, 40rem)
    display: flex
    flex-direction: column
    justify-content: center
    overflow: hidden

  .mg-hero-inner
    position: relative
    z-index: 2
    max-width: 60rem

  .mg-eyebrow
    display: flex
    align-items: center
    gap: 0.9rem
    font-family: 'JetBrains Mono Variable', monospace
    font-size: 0.72rem
    letter-spacing: 0.28em
    color: var(--mg-muted)
    margin-bottom: 1.6rem
  .mg-stitches
    color: var(--mg-ink)
    opacity: 0.7
    display: inline-flex

  .mg-name
    font-size: clamp(4rem, 17vw, 12rem)
    font-weight: 300
    line-height: 0.9
    letter-spacing: -0.04em
    margin: 0
    color: var(--mg-ink)
    cursor: default
  .mg-caption
    margin-top: 1.4rem
    font-family: 'JetBrains Mono Variable', monospace
    font-size: 0.9rem
    letter-spacing: 0.24em
    color: var(--mg-ink)
    display: flex
    align-items: center
    gap: 0.7rem
  .mg-circle-mark
    width: 0.7rem
    height: 0.7rem
    border: 1.5px solid var(--mg-ink)
    border-radius: 999px
    display: inline-block
    transform: rotate(-8deg)
  .mg-bio
    margin-top: 1rem
    font-size: 0.95rem
    color: var(--mg-muted)
    letter-spacing: 0.02em

  .mg-social
    display: flex
    flex-wrap: wrap
    gap: 2rem
    margin-top: 2.6rem
  .mg-link
    position: relative
    font-family: 'JetBrains Mono Variable', monospace
    font-size: 0.86rem
    letter-spacing: 0.14em
    color: var(--mg-ink)
    text-transform: uppercase
    padding-bottom: 0.3rem
    will-change: transform
  .mg-link::after
    content: ""
    position: absolute
    left: 0
    bottom: 0
    width: 100%
    height: 0
    border-bottom: 1.5px dashed var(--mg-ink)
    transform: scaleX(0)
    transform-origin: left
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1)
  .mg-link:hover::after
    transform: scaleX(1)

  .mg-scroll
    position: absolute
    left: 0.5rem
    bottom: 1.5rem
    z-index: 2
    display: flex
    align-items: center
    gap: 0.7rem
    font-family: 'JetBrains Mono Variable', monospace
    font-size: 0.62rem
    letter-spacing: 0.3em
    color: var(--mg-muted)
  .mg-scroll i
    width: 3rem
    height: 1px
    background: var(--mg-line)
    position: relative
    overflow: hidden
  .mg-scroll i::after
    content: ""
    position: absolute
    inset: 0
    width: 40%
    background: var(--mg-ink)
    animation: mg-scroll 2s ease-in-out infinite
  @keyframes mg-scroll
    0%
      transform: translateX(-100%)
    100%
      transform: translateX(250%)

  @media (prefers-reduced-motion: reduce)
    .mg-scroll i::after
      animation: none
</style>
