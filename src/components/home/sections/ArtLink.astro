---
import '@fontsource-variable/jetbrains-mono'
---
<a class="mg-art reveal" href="/art/" data-magnetic>
  <span class="mg-art-label">p5go — creative coding in Go</span>
  <span class="mg-art-title">Art Gallery <i>↗</i></span>
</a>

<style lang="stylus">
  .mg-art
    display: inline-flex
    flex-direction: column
    gap: 0.5rem
    will-change: transform
  .mg-art-label
    font-family: 'JetBrains Mono Variable', monospace
    font-size: 0.72rem
    letter-spacing: 0.16em
    text-transform: uppercase
    color: var(--mg-muted)
  .mg-art-title
    font-size: clamp(2rem, 6vw, 3.4rem)
    font-weight: 300
    letter-spacing: -0.02em
    color: var(--mg-ink)
  .mg-art-title i
    font-style: normal
    transition: margin-left 0.3s ease
  .mg-art:hover .mg-art-title i
    margin-left: 0.5rem
</style>
