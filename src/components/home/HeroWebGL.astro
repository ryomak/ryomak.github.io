---
// WebGL "living" hero: a 3D particle nebula flowing through a curl-ish field,
// with a slowly rotating wireframe icosahedron for structure. Theme-hue aware,
// dark/light aware, reacts to mouse + scroll, respects prefers-reduced-motion,
// and degrades to a CSS gradient when WebGL is unavailable.
const { colorVar = '--primary', mono = false } = Astro.props
const className = Astro.props.class
---
<div class:list={[className, 'hero-webgl pointer-events-none absolute inset-0']} aria-hidden="true">
  <div class="hero-webgl-fallback"></div>
  <canvas id="hero-webgl-canvas" class="hero-webgl-canvas" data-color-var={colorVar} data-mono={mono ? '1' : ''}></canvas>
</div>

<style>
  .hero-webgl-canvas,
  .hero-webgl-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-webgl-fallback {
    background: radial-gradient(
      120% 90% at 78% 18%,
      oklch(0.7 0.13 var(--hue) / 0.16),
      transparent 60%
    );
  }
  .hero-webgl-canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-webgl-canvas.is-ready {
    opacity: 1;
  }
</style>

<script>
  import * as THREE from 'three'

  function startHeroWebGL() {
    const canvas = document.getElementById('hero-webgl-canvas') as HTMLCanvasElement | null
    if (!canvas) return () => {}

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    let renderer: THREE.WebGLRenderer
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'low-power' })
    } catch {
      return () => {} // no WebGL → CSS gradient fallback stays
    }

    const isDark = () => document.documentElement.classList.contains('dark')
    const colorVar = canvas.dataset.colorVar || '--primary'
    const mono = canvas.dataset.mono === '1'

    // Pull the live theme colour straight from CSS so it tracks theme/hue changes.
    const readPrimary = (): THREE.Color => {
      const probe = getComputedStyle(canvas).getPropertyValue('color') || 'rgb(45, 190, 150)'
      const c = new THREE.Color()
      try { c.setStyle(probe.trim()) } catch { c.setRGB(0.18, 0.74, 0.58) }
      return c
    }
    // canvas inherits the chosen colour var via inline style for the probe above
    canvas.style.color = `var(${colorVar})`

    const scene = new THREE.Scene()
    const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100)
    camera.position.set(0, 0, 9)

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))

    const group = new THREE.Group()
    scene.add(group)

    // ---- Particle nebula ----
    const makeCount = (w: number) => Math.round(Math.min(4200, Math.max(1400, (w * 480) / 10)))
    let count = makeCount(window.innerWidth)

    const buildParticles = (n: number) => {
      const positions = new Float32Array(n * 3)
      const scales = new Float32Array(n)
      for (let i = 0; i < n; i++) {
        // distribute in a soft ellipsoid volume
        const r = Math.cbrt(Math.random())
        const theta = Math.random() * Math.PI * 2
        const phi = Math.acos(2 * Math.random() - 1)
        positions[i * 3] = r * Math.sin(phi) * Math.cos(theta) * 6.5
        positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta) * 4.2
        positions[i * 3 + 2] = r * Math.cos(phi) * 4.2
        scales[i] = 0.5 + Math.random() * 1.6
      }
      const geo = new THREE.BufferGeometry()
      geo.setAttribute('position', new THREE.BufferAttribute(positions, 3))
      geo.setAttribute('aScale', new THREE.BufferAttribute(scales, 1))
      return geo
    }

    const uniforms = {
      uTime: { value: 0 },
      uSize: { value: 3.4 },
      uPixelRatio: { value: renderer.getPixelRatio() },
      uColor: { value: readPrimary() },
      uAlpha: { value: mono ? (isDark() ? 0.22 : 0.16) : (isDark() ? 0.95 : 0.72) },
    }

    const material = new THREE.ShaderMaterial({
      uniforms,
      transparent: true,
      depthWrite: false,
      blending: (!mono && isDark()) ? THREE.AdditiveBlending : THREE.NormalBlending,
      vertexShader: `
        uniform float uTime;
        uniform float uSize;
        uniform float uPixelRatio;
        attribute float aScale;
        varying float vAlpha;

        vec3 flow(vec3 p, float t) {
          float x = sin(p.y * 0.6 + t) + cos(p.z * 0.5 - t * 0.8);
          float y = sin(p.z * 0.6 + t * 1.1) + cos(p.x * 0.5 - t * 0.7);
          float z = sin(p.x * 0.6 + t * 0.9) + cos(p.y * 0.5 - t * 0.6);
          return vec3(x, y, z);
        }

        void main() {
          vec3 p = position;
          float t = uTime * 0.18;
          p += flow(p * 0.42, t) * 0.4;
          vec4 mv = modelViewMatrix * vec4(p, 1.0);
          gl_Position = projectionMatrix * mv;
          gl_PointSize = uSize * aScale * uPixelRatio * (9.0 / -mv.z);
          vAlpha = clamp(1.0 - (-mv.z - 4.0) / 15.0, 0.06, 1.0);
        }
      `,
      fragmentShader: `
        uniform vec3 uColor;
        uniform float uAlpha;
        varying float vAlpha;
        void main() {
          float d = distance(gl_PointCoord, vec2(0.5));
          if (d > 0.5) discard;
          float a = smoothstep(0.5, 0.0, d) * vAlpha * uAlpha;
          gl_FragColor = vec4(uColor, a);
        }
      `,
    })

    let points = new THREE.Points(buildParticles(count), material)
    group.add(points)

    // ---- Wireframe icosahedron (subtle structure) ----
    const wireGeo = new THREE.WireframeGeometry(new THREE.IcosahedronGeometry(3.4, 1))
    const wireMat = new THREE.LineBasicMaterial({
      color: uniforms.uColor.value,
      transparent: true,
      opacity: mono ? (isDark() ? 0.06 : 0.08) : (isDark() ? 0.12 : 0.2),
    })
    const wire = new THREE.LineSegments(wireGeo, wireMat)
    group.add(wire)

    // ---- Interaction ----
    const mouse = new THREE.Vector2(0, 0)
    const targetRot = new THREE.Vector2(0, 0)
    let scroll = 0

    const onPointer = (e: PointerEvent) => {
      mouse.x = (e.clientX / window.innerWidth) * 2 - 1
      mouse.y = (e.clientY / window.innerHeight) * 2 - 1
    }
    const onScroll = () => {
      scroll = window.scrollY
    }
    window.addEventListener('pointermove', onPointer, { passive: true })
    window.addEventListener('scroll', onScroll, { passive: true })

    // ---- Resize ----
    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const w = Math.max(1, rect.width)
      const h = Math.max(1, rect.height)
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
      uniforms.uPixelRatio.value = renderer.getPixelRatio()
      renderer.setSize(w, h, false)
      camera.aspect = w / h
      camera.updateProjectionMatrix()

      const next = makeCount(window.innerWidth)
      if (Math.abs(next - count) > 300) {
        count = next
        group.remove(points)
        points.geometry.dispose()
        points = new THREE.Points(buildParticles(count), material)
        group.add(points)
      }
    }
    const ro = new ResizeObserver(resize)
    ro.observe(canvas)
    resize()

    // ---- Theme / hue sync ----
    const syncTheme = () => {
      const dark = isDark()
      uniforms.uColor.value = readPrimary()
      uniforms.uAlpha.value = mono ? (dark ? 0.22 : 0.16) : (dark ? 0.95 : 0.72)
      material.blending = (!mono && dark) ? THREE.AdditiveBlending : THREE.NormalBlending
      material.needsUpdate = true
      wireMat.color = uniforms.uColor.value
      wireMat.opacity = mono ? (dark ? 0.06 : 0.08) : (dark ? 0.12 : 0.2)
    }
    const themeObserver = new MutationObserver(syncTheme)
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] })

    // ---- Loop ----
    let raf = 0
    let running = true
    const clock = new THREE.Clock()

    canvas.classList.add('is-ready')

    const render = () => {
      uniforms.uTime.value = clock.getElapsedTime()

      targetRot.x += (mouse.y * 0.25 - targetRot.x) * 0.04
      targetRot.y += (mouse.x * 0.35 - targetRot.y) * 0.04

      group.rotation.x = targetRot.x + scroll * 0.0006
      group.rotation.y = clock.getElapsedTime() * 0.04 + targetRot.y
      wire.rotation.z = clock.getElapsedTime() * 0.03

      camera.position.z = 9 + Math.min(scroll, 600) * 0.0016

      renderer.render(scene, camera)
    }

    const tick = () => {
      if (!running) return
      render()
      raf = requestAnimationFrame(tick)
    }

    if (reduceMotion) {
      render() // one static frame
    } else {
      raf = requestAnimationFrame(tick)
    }

    return () => {
      running = false
      cancelAnimationFrame(raf)
      ro.disconnect()
      themeObserver.disconnect()
      window.removeEventListener('pointermove', onPointer)
      window.removeEventListener('scroll', onScroll)
      points.geometry.dispose()
      wireGeo.dispose()
      material.dispose()
      wireMat.dispose()
      renderer.dispose()
    }
  }

  // swup-safe boot: this theme swaps <main> only, so re-init on page:view.
  let cleanup: (() => void) | null = null
  const boot = () => {
    cleanup?.()
    cleanup = document.getElementById('hero-webgl-canvas') ? startHeroWebGL() : null
  }
  const teardown = () => {
    cleanup?.()
    cleanup = null
  }

  boot()

  const bindSwup = () => {
    const swup = (window as any).swup
    if (!swup?.hooks) return
    swup.hooks.on('visit:start', teardown)
    swup.hooks.on('page:view', boot)
  }
  if ((window as any).swup?.hooks) bindSwup()
  else document.addEventListener('swup:enable', bindSwup)
  document.addEventListener('astro:page-load', boot)
</script>
