---
interface Props {
  badge?: string
  url?: string
  label?: string
}
const { badge, url, label } = Astro.props
---
<a href={url} aria-label={label} class="category-link">
    <span class="category-name"><slot></slot></span>
    {badge !== undefined && badge !== null && badge !== '' && <span class="category-count">{badge}</span>}
</a>

<style lang="stylus">
  .category-link
    display: flex
    align-items: center
    justify-content: space-between
    gap: 1rem
    padding: 0.5rem 0.55rem
    border-radius: 6px
    color: rgba(190, 190, 190, 0.92)
    font-size: 0.84rem
    transition: color 0.2s ease, background 0.2s ease
  .category-link:hover
    color: var(--primary)
    background: var(--btn-plain-bg-hover)
  .category-name
    overflow: hidden
    white-space: nowrap
    text-overflow: ellipsis
  .category-count
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.66rem
    color: rgba(140, 140, 140, 0.75)
  @media (max-width: 1023px)
    .category-link
      min-height: 2.75rem
      padding: 0.65rem 0.55rem
</style>
