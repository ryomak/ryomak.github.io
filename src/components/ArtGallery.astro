---
import { arts, getArtWasmName } from '../../art/data/data'
import PageHeader from './PageHeader.astro'
import '@fontsource-variable/jetbrains-mono'

const sortedArts = [...arts].sort((a, b) => new Date(b.at).getTime() - new Date(a.at).getTime())
---

<section class="art-page">
  <PageHeader
    title="Art"
    subtitle="Goで書くクリエイティブコーディング。p5goによるジェネラティブアートコレクション。"
    count={sortedArts.length}
    countLabel="artworks"
  />

  <!-- Editor CTA -->
  <a href="https://p5go-editor.ryomak.jp/" class="editor-card reveal card-base group" target="_blank" rel="noopener">
    <div class="editor-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
    </div>
    <div class="editor-text">
      <span class="editor-label">Playground</span>
      <h3 class="editor-title">p5go Editor</h3>
      <p class="editor-sub">ブラウザ上でp5goのコードを試せるWebエディタ</p>
    </div>
    <span class="editor-cta">
      Try it
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </span>
  </a>

  <!-- Gallery -->
  <div class="gallery-section card-base">
    <div class="section-head reveal">
      <span class="sh-caret">&gt;</span>
      <h2 class="sh-title">Works</h2>
      <div class="sh-rule"></div>
    </div>

    <div class="art-gallery">
      {sortedArts.map((art, index) => (
        <a
          href={`/art/detail/${getArtWasmName(art)}/`}
          class="artwork-card reveal group"
          style={`--d: ${index * 55}ms`}
        >
          <div class="card-image-wrapper">
            <img
              src={`/art/${art.language}/${art.name}/art.gif`}
              alt={art.name}
              class="artwork-preview"
              loading="lazy"
            />
            <div class="card-overlay">
              <span class="view-text">View</span>
            </div>
          </div>
          <div class="card-info">
            <span class="artwork-name">{art.name.replace(/_/g, ' ')}</span>
            <span class="artwork-date">{art.at}</span>
          </div>
          <div class="card-accent"></div>
        </a>
      ))}
    </div>
  </div>
</section>

<style lang="stylus">
  .art-page
    min-height: 100%

  // Editor CTA
  .editor-card
    display: flex
    align-items: center
    gap: 1rem
    padding: 1.15rem 1.4rem
    margin-bottom: 1rem
    text-decoration: none
    color: inherit
    transition: transform 0.3s ease, background 0.25s ease
  .editor-card:hover
    transform: translateY(-3px)
    background: var(--btn-card-bg-hover)
  .editor-icon
    display: flex
    align-items: center
    justify-content: center
    width: 52px
    height: 52px
    border-radius: 14px
    background: var(--btn-regular-bg)
    color: var(--primary)
    flex-shrink: 0
    transition: transform 0.3s ease
  .editor-card:hover .editor-icon
    transform: rotate(-6deg) scale(1.05)
  .editor-text
    flex: 1
    min-width: 0
  .editor-label
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.68rem
    letter-spacing: 0.12em
    text-transform: uppercase
    color: var(--primary)
  .editor-title
    font-size: 1.1rem
    font-weight: 700
    margin: 0.1rem 0 0.15rem
  .editor-sub
    font-size: 0.82rem
    margin: 0
    color: rgba(128, 128, 128, 0.9)
  .editor-cta
    display: inline-flex
    align-items: center
    gap: 0.45rem
    padding: 0.6rem 1.1rem
    border-radius: 999px
    background: var(--primary)
    /* --primary is near-white on the dark canvas, so the label has to take the
       page colour rather than a hard-coded white */
    color: var(--page-bg)
    font-size: 0.88rem
    font-weight: 600
    flex-shrink: 0
    transition: gap 0.25s ease
  .editor-card:hover .editor-cta
    gap: 0.7rem

  // Gallery section
  .gallery-section
    padding: 1.6rem 1.5rem 1.8rem

  .section-head
    display: flex
    align-items: center
    gap: 0.7rem
    margin-bottom: 1.4rem
  .sh-caret
    display: none
  .sh-title
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 1.15rem
    font-weight: 500
    letter-spacing: -0.01em
  .sh-rule
    display: none

  .art-gallery
    display: grid
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))
    gap: 1.25rem

  // Artwork card
  .artwork-card
    display: block
    position: relative
    background: var(--btn-regular-bg)
    border-radius: 14px
    overflow: hidden
    text-decoration: none
    color: inherit
    border: 0
    transition: transform 0.35s ease, background 0.25s ease
  .artwork-card:hover
    transform: translateY(-5px)
    background: var(--btn-regular-bg-hover)
  .artwork-card:hover .card-overlay
    opacity: 1
  .artwork-card:hover .card-accent
    transform: scaleX(1)

  .card-image-wrapper
    position: relative
    aspect-ratio: 1
    overflow: hidden
  .artwork-preview
    width: 100%
    height: 100%
    object-fit: cover
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)
  .artwork-card:hover .artwork-preview
    transform: scale(1.035)

  .card-overlay
    position: absolute
    inset: 0
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 50%)
    display: flex
    align-items: flex-end
    justify-content: center
    padding-bottom: 1rem
    opacity: 0
    transition: opacity 0.3s ease
  .view-text
    font-size: 0.82rem
    font-weight: 600
    color: var(--page-bg)
    padding: 0.4rem 1rem
    background: var(--primary)
    border-radius: 999px

  .card-info
    display: flex
    flex-direction: column
    gap: 0.25rem
    padding: 0.85rem 1rem
  .artwork-name
    font-size: 0.92rem
    font-weight: 600
    text-transform: capitalize
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
  .artwork-date
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.73rem
    color: rgba(140, 140, 140, 0.85)

  .card-accent
    display: none

  @media (max-width: 640px)
    .editor-card
      flex-wrap: wrap
    .editor-cta
      width: 100%
      justify-content: center
    .art-gallery
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr))
      gap: 1rem
    .gallery-section
      padding: 1.2rem 1rem 1.4rem
</style>
