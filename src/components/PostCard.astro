---
import path from 'path'
import ImageWrapper from './misc/ImageWrapper.astro'
import { Icon } from 'astro-icon/components'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import { getDir } from '../utils/url-utils'
import { formatDateToYYYYMMDD } from '../utils/date-utils'
import '@fontsource-variable/jetbrains-mono'

interface Props {
  class: string
  entry: any
  title: string
  url: string
  published: Date
  tags: string[]
  category: string
  image: string
  description: string
  words: number
  draft: boolean
  style: string
}
const {
  entry,
  title,
  url,
  published,
  tags,
  category,
  image,
  description,
} = Astro.props
const className = Astro.props.class
const style = Astro.props.style

const hasCover = image !== undefined && image !== null && image !== ''
const isExternal = entry.data.external

const wordFetch = async entry => {
  if (entry.data.external) {
    return { words: '-', minutes: '-' }
  }
  const { remarkPluginFrontmatter } = await entry.render()
  return {
    words: remarkPluginFrontmatter.words,
    minutes: remarkPluginFrontmatter.minutes,
  }
}
const wordData = await wordFetch(entry)
---
<article class:list={["post-card reveal card-base group", className]} style={style}>
  <a href={url} aria-label={title} class="post-card-link" target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener' : undefined}>
    <span class="post-accent"></span>

    <div class="post-body">
      <div class="post-meta">
        <time class="post-date">{formatDateToYYYYMMDD(published)}</time>
        <span class="post-cat">{category || i18n(I18nKey.uncategorized)}</span>
        {isExternal && <span class="post-ext">EXTERNAL</span>}
      </div>

      <h2 class="post-title">{title}</h2>

      {description && <p class="post-desc">{description}</p>}

      <div class="post-footer">
        {!isExternal && (
          <span class="post-readtime">
            {wordData.minutes} {i18n(I18nKey.minutesCount)}
          </span>
        )}
        <div class="post-tags">
          {(tags && tags.length > 0) && tags.slice(0, 4).map(tag => (
            <span class="post-tag">#{tag}</span>
          ))}
        </div>
      </div>
    </div>

    {hasCover && (
      <div class="post-cover">
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt={title} class="post-cover-img" />
      </div>
    )}

    <span class="post-arrow">
      <Icon name={isExternal ? 'fa6-solid:arrow-up-right-from-square' : 'material-symbols:arrow-forward-rounded'} />
    </span>
  </a>
</article>

<style lang="stylus">
  .post-card
    margin-bottom: 1rem
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s ease
  .post-card:hover
    transform: translateY(-4px)
    background: var(--btn-card-bg-hover)

  .post-card-link
    position: relative
    display: flex
    align-items: stretch
    gap: 1.25rem
    padding: 1.7rem 1.8rem
    overflow: hidden

  .post-accent
    display: none

  .post-body
    flex: 1
    min-width: 0

  .post-meta
    display: flex
    align-items: center
    gap: 0.6rem
    margin-bottom: 0.6rem
    flex-wrap: wrap
  .post-date
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.8rem
    color: rgba(130, 130, 130, 0.95)
  .post-cat
    font-size: 0.7rem
    font-weight: 500
    letter-spacing: 0.03em
    text-transform: uppercase
    color: var(--primary)
    padding: 0
  .post-ext
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.62rem
    letter-spacing: 0.08em
    color: rgba(130, 130, 130, 0.9)
    border: 1px solid rgba(130, 130, 130, 0.3)
    padding: 0.08rem 0.4rem
    border-radius: 4px

  .post-title
    font-size: clamp(1.15rem, 2.2vw, 1.5rem)
    font-weight: 500
    line-height: 1.3
    color: var(--deep-text, #232323)
    transition: color 0.2s ease
    display: -webkit-box
    -webkit-line-clamp: 2
    -webkit-box-orient: vertical
    overflow: hidden
  :global(.dark) .post-title
    color: #ededed
  .post-card:hover .post-title
    color: var(--primary)

  .post-desc
    margin-top: 0.55rem
    font-size: 0.92rem
    line-height: 1.6
    color: rgba(115, 115, 115, 0.95)
    display: -webkit-box
    -webkit-line-clamp: 2
    -webkit-box-orient: vertical
    overflow: hidden

  .post-footer
    display: flex
    align-items: center
    gap: 0.9rem
    margin-top: 0.9rem
    flex-wrap: wrap
  .post-readtime
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace
    font-size: 0.74rem
    color: rgba(140, 140, 140, 0.9)
  .post-tags
    display: flex
    gap: 0.4rem
    flex-wrap: wrap
  .post-tag
    font-size: 0.72rem
    color: rgba(120, 120, 120, 0.95)
    transition: color 0.2s ease
  .post-card:hover .post-tag
    color: var(--primary)

  .post-cover
    flex: 0 0 34%
    max-width: 34%
    border-radius: 12px
    overflow: hidden
    align-self: stretch
    min-height: 8.5rem
  .post-cover-img
    width: 100%
    height: 100%
    object-fit: cover
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)
  .post-card:hover .post-cover-img
    transform: scale(1.035)

  .post-arrow
    position: absolute
    right: 1.4rem
    bottom: 1.3rem
    color: var(--primary)
    font-size: 1.05rem
    opacity: 0
    transform: translateX(-6px)
    transition: opacity 0.3s ease, transform 0.3s ease
  .post-card:hover .post-arrow
    opacity: 1
    transform: translateX(0)

  @media (max-width: 768px)
    .post-card-link
      flex-direction: column-reverse
      padding: 1.3rem 1.4rem
    .post-cover
      flex: none
      max-width: 100%
      width: 100%
      height: 10rem
      min-height: 0
    .post-accent
      display: none
    .post-arrow
      display: none
</style>
