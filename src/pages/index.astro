---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import { profileConfig } from '../config'

import { sections } from '@components/home/data'
import Section from '@components/home/Section.astro'
import Divider from '@components/home/Divider.astro'
import Hero from '@components/home/sections/Hero.astro'
import Now from '@components/home/sections/Now.astro'
import Writing from '@components/home/sections/Writing.astro'
import Skills from '@components/home/sections/Skills.astro'
import ArtLink from '@components/home/sections/ArtLink.astro'

import '../styles/home-margiela.css'

const [, now, writing, skills, art] = sections
---

<MainGridLayout title={i18n(I18nKey.home)} description={profileConfig.bio} slug="none">
  <div class="mg">
    <Hero />

    <Divider />
    <Section index={now.index} id={now.id} num={now.num} name={now.name}>
      <Now />
    </Section>

    <Divider />
    <Section index={writing.index} id={writing.id} num={writing.num} name={writing.name}>
      <Writing />
    </Section>

    <Divider />
    <Section index={skills.index} id={skills.id} num={skills.num} name={skills.name}>
      <Skills />
    </Section>

    <Divider />
    <Section index={art.index} id={art.id} num={art.num} name={art.name}>
      <ArtLink />
    </Section>
  </div>
</MainGridLayout>

<style lang="stylus">
  .mg
    position: relative
    color: var(--mg-ink)
    font-family: 'Roboto', -apple-system, sans-serif
</style>

<script>
  import '../scripts/home-margiela'
</script>
